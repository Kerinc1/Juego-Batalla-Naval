<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.batallanaval.batallanaval.controller.PlacementController" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700" prefWidth="1100" style="-fx-background-color: #D7ECF8;" stylesheets="@placement.css">

    <top>
        <VBox alignment="CENTER" prefHeight="58.0" styleClass="header">
            <Label text="BATALLA NAVAL - COLOCACIÓN DE BARCOS" />
        </VBox>
    </top>

    <center>
        <HBox spacing="24" style="-fx-padding: 22 24 24 24;">
            <VBox fx:id="panelIzquierdo" spacing="15" styleClass="panel-container" prefWidth="280" VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" fitToHeight="true" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;" prefHeight="520">
                    <content>
                        <VBox fx:id="flotaDisponibleVBox" spacing="12" styleClass="flota-panel"/>
                    </content>
                </ScrollPane>

                <Label text="" style="-fx-padding: 4;"/>

                <Button fx:id="botonRotar" text="Rotar (R)" prefWidth="220"/>
                <Button fx:id="botonReiniciar" text="Reiniciar" prefWidth="220" styleClass="button-danger"/>
                <Button fx:id="botonIniciarPartida" text="Iniciar Partida" disable="true" prefWidth="220" styleClass="button-warning"/>

                <Label fx:id="etiquetaEstado" text="Barcos colocados: 0/10" style="-fx-font-size: 11; -fx-text-fill: #666666; -fx-wrap-text: true;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="12" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                <Pane fx:id="tableroPane" prefHeight="560" prefWidth="560" styleClass="board-pane"/>
                <Label text="Arrastra los barcos al tablero" style="-fx-font-size: 11; -fx-text-fill: #666666; -fx-alignment: center;"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
