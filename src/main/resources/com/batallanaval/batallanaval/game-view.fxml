<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.batallanaval.batallanaval.controller.GameController" style="-fx-background-color: #D7ECF8;" stylesheets="@placement.css">
    <top>
        <VBox alignment="CENTER" spacing="6" styleClass="header" style="-fx-padding: 10 0 10 0;">
            <Label text="BATALLA NAVAL - PARTIDA" style="-fx-font-size: 20; -fx-text-fill: white; -fx-font-weight: bold;" />
            <Label fx:id="statusLabel" text="Turno del jugador. Dispara sobre el tablero enemigo." style="-fx-font-size: 12; -fx-text-fill: white;" />
        </VBox>
    </top>
    <center>
        <HBox spacing="20" style="-fx-padding: 24;">
            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <Label text="Tablero propio" style="-fx-font-size: 14; -fx-text-fill: #325D78; -fx-font-weight: bold;" />
                <Pane fx:id="playerBoardPane" prefHeight="560" prefWidth="560" styleClass="board-pane" />
            </VBox>
            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <Label text="Tablero enemigo" style="-fx-font-size: 14; -fx-text-fill: #325D78; -fx-font-weight: bold;" />
                <Pane fx:id="enemyBoardPane" prefHeight="560" prefWidth="560" styleClass="board-pane" />
                <VBox spacing="8" style="-fx-padding: 8 0 0 0;">
                    <Label text="Información del tablero enemigo:" style="-fx-font-size: 12; -fx-text-fill: #325D78; -fx-font-weight: bold;" />
                    <HBox spacing="12">
                        <Label text="✕ Agua" style="-fx-font-size: 12; -fx-text-fill: #4F5A65;" />
                        <Label text="● Tocado" style="-fx-font-size: 12; -fx-text-fill: #E74C3C;" />
                        <Label text="■ Hundido" style="-fx-font-size: 12; -fx-text-fill: #7F8790;" />
                    </HBox>
                    <Label text="Un barco se hunde cuando todas sus casillas han sido acertadas. No puedes volver a disparar en una casilla ya usada." wrapText="true" style="-fx-font-size: 11; -fx-text-fill: #2D3B46;" />
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
